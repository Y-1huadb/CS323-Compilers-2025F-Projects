int main() {
    int x = 100 + 25;
    int y = x + 10;
    // 1. + - * / 计算
    int a = 1 + 1;
    int b = 1 - 1;
    int c = 2 * 2;
    int d = 3 / 4;
    // 2. () 计算
    int e = (1 + 2) * 3;
    // 3. + -
    int f = 6 + (-2);
    int g = -2;
    // 4. 同级顺序
    int h = 3 * 2 / 5;
    // 5. 加减和乘除顺序
    int i = 3 * -2 * 1 + 2 * 9;
    // 6. 函数
    int j = add(1,2);
    // 7. ','等无意义操作符
    int k = (1 , 2);
    // 8. 变量参与
    int l = i * 2;
    // 9. 数组访问
    int m = g[1] + 2;
    return x;
}